# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.toml text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.svg text
*.ico binary
*.webp binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Documents
*.pdf binary

# Legacy Maven wrapper
/legacy/mvnw text eol=lf
